{
  "expo": {
    "name": "suhaimast",
    "slug": "suhaimast",
    "version": "1.0.0",
    "icon": "./assets/images/ic_launcher_monochrome.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.suhaimsoft.suhaimast"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ic_launcher_monochrome.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
